  m_TableData:
  - m_Id: 23017324544
    m_Localized: INICIAR
    m_Metadata:
      m_Items: []
  - m_Id: 23034101760
    m_Localized: QUIZ
    m_Metadata:
      m_Items: []
  - m_Id: 23034101761
    m_Localized: "CR\xC9DITOS"
    m_Metadata:
      m_Items: []
  - m_Id: 23034101762
    m_Localized: "C\xE9lulas AR"
    m_Metadata:
      m_Items: []
  - m_Id: 23034101763
    m_Localized: "Conhe\xE7a o interior de diferentes tipos de c\xE9lulas em 3D de
      forma interativa."
    m_Metadata:
      m_Items: []
  - m_Id: 23034101764
    m_Localized: "Aponte a c\xE2mera do seu celular para a imagem da c\xE9lula para
      v\xEA-la em 3D"
    m_Metadata:
      m_Items: []
  - m_Id: 5348955637448704
    m_Localized: "Para rotacion\xE1-la, toque e arraste o dedo pela tela.\n\nTocando
      nas organelas voc\xEA ver\xE1 e ouvir\xE1 informa\xE7\xF5es e curiosidades
      sobre elas."
    m_Metadata:
      m_Items: []
  - m_Id: 5349178308853760
    m_Localized: "Voc\xEA tamb\xE9m pode aproximar a c\xE2mera para v\xEA-la mais
      de perto, ou afastar o celular para uma vis\xE3o mais ampla."
    m_Metadata:
      m_Items: []
  - m_Id: 5350016410484736
    m_Localized: "Obtenha as imagens das c\xE9lulas atrav\xE9s do bot\xE3o abaixo
      ou visitando o Espa\xE7o Interativo de Ci\xEAncias pessoalmente!"
    m_Metadata:
      m_Items: []
  - m_Id: 5350228122173440
    m_Localized: Download das imagens
    m_Metadata:
      m_Items: []
  - m_Id: 10428849425776640
    m_Localized: "Aqui aparecer\xE1 o Nome da Organela da C\xE9lula"
    m_Metadata:
      m_Items: []
  - m_Id: 10429769236643840
    m_Localized: "No microcosmo pulsante de uma c\xE9lula, onde a vida se desdobra
      em um espet\xE1culo de intrincadas dan\xE7as moleculares, as organelas assumem
      pap\xE9is fundamentais. Imagine-se adentrando este universo min\xFAsculo, onde
      cada estrutura desempenha uma fun\xE7\xE3o \xFAnica, contribuindo para a harmonia
      essencial da c\xE9lula.\r\n\r\nNo epicentro, est\xE1 o n\xFAcleo, a biblioteca
      gen\xE9tica que guarda as instru\xE7\xF5es para a exist\xEAncia da c\xE9lula.
      Aqui, os cromossomos dan\xE7am, entrela\xE7ando-se em um bal\xE9 gen\xE9tico
      que molda a identidade da c\xE9lula e conduz seu destino.\r"
    m_Metadata:
      m_Items: []
  references:
    version: 2
